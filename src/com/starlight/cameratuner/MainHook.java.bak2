    private void loadConfig() {
        File f = new File(CONF_PATH);
        if (!f.exists()) {
            ensureConfigExists(f);
        }
        if (!f.exists()) {
            logi("配置文件不存在且创建失败，使用默认值");
            return;
        }
        try (BufferedReader br = new BufferedReader(new FileReader(f))) {
            String line;
            while ((line = br.readLine()) != null) {
                line = line.trim();
                if (line.isEmpty() || line.startsWith("#")) continue;
                int eq = line.indexOf('=');
                if (eq < 0) continue;
                String k = line.substring(0, eq).trim();
                String v = line.substring(eq + 1).trim();
                switch (k) {
                    case "level":
                        try { cfgLevel = Integer.parseInt(v); } catch (Exception ignored) {}
                        break;
                    case "log":
                        cfgLog = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "fake.enable":
                        cfgFake = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "watermark.name":
                        cfgWatermarkName = v;
                        break;
                    case "watermark.enable":
                        cfgWatermarkEnable = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "block.msg":
                        if (!v.isEmpty()) {
                            blockMsgSet.clear();
                            for (String x : v.split(",")) {
                                try { blockMsgSet.add(Integer.parseInt(x.trim())); }
                                catch (Exception ignored) {}
                            }
                        }
                        break;
                    case "caps.force":
                        cfgForceCaps = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "cvtype.natural":
                        cfgCvNatural = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "tilt.switch":
                        cfgTiltSwitch = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "flash.fix":
                        cfgFlashFix = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "live.supertele":
                        cfgLiveSupTele = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "log.filter":
                        logFilter.clear();
                        for (String x : v.split(",")) {
                            String t = x.trim();
                            if (!t.isEmpty()) logFilter.add(t);
                        }
                        break;
                    case "aiwm.enable":
                        cfgAiWm = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "opengate.enable":
                        cfgOpenGate = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "opmode.force":
                        try {
                            if (v.startsWith("0x") || v.startsWith("0X")) {
                                cfgOpMode = Integer.parseInt(v.substring(2), 16);
                            } else {
                                cfgOpMode = Integer.parseInt(v);
                            }
                        } catch (Exception ignored) {}
                        break;
                    case "raw.size":
                        try {
                            String[] wh = v.toLowerCase().split("x");
                            cfgRawW = Integer.parseInt(wh[0].trim());
                            cfgRawH = Integer.parseInt(wh[1].trim());
                        } catch (Exception ignored) {}
                        break;
                    case "raw.type":
                        try {
                            // 支持 16 / 0x10 两种写法
                            if (v.startsWith("0x") || v.startsWith("0X")) {
                                cfgRawType = Integer.parseInt(v.substring(2), 16);
                            } else {
                                cfgRawType = Integer.parseInt(v);
                            }
                        } catch (Exception ignored) {}
                        break;
                    case "zoom.enable":
                        cfgZoom = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "legend.prolens":
                        cfgProLens = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "prolens.idx_ultra":
                        try { idxUltra = Integer.parseInt(v); } catch (Exception ignored) {}
                        break;
                    case "prolens.idx_wide":
                        try { idxWide = Integer.parseInt(v); } catch (Exception ignored) {}
                        break;
                    case "prolens.idx_mid":
                        try { idxMid = Integer.parseInt(v); } catch (Exception ignored) {}
                        break;
                    case "prolens.idx_tele":
                        try { idxTele = Integer.parseInt(v); } catch (Exception ignored) {}
                        break;
                    case "prolens.zoom_mid":
                        try { zoomMidFrom = Float.parseFloat(v); } catch (Exception ignored) {}
                        break;
                    case "prolens.zoom_tele":
                        try { zoomTeleFrom = Float.parseFloat(v); } catch (Exception ignored) {}
                        break;
                    case "legend.prolens_modes":
                        proLensModes.clear();
                        for (String m : v.split(",")) {
                            try { proLensModes.add(Integer.parseInt(m.trim())); }
                            catch (Exception ignored) {}
                        }
                        break;
                    case "legend.zoomcycle":
                        cfgZoomCycle = "1".equals(v) || "true".equalsIgnoreCase(v);
                        break;
                    case "legend.zoomcycle_min":
                        try { zoomCycleMin = Float.parseFloat(v); } catch (Exception ignored) {}
                        break;
                    case "legend.zoomcycle_modes":
                        for (String m : v.split(",")) {
                            try { zoomCycleModes.add(Integer.parseInt(m.trim())); }
                            catch (Exception ignored) {}
                        }
                        break;
                    case "legend.zoomcycle_stops":
                        for (String m : v.split(",")) {
                            try { zoomCycleStops.add(Float.parseFloat(m.trim())); }
                            catch (Exception ignored) {}
                        }
                        break;
                    case "zoom_remap":
                        for (String pair : v.split(",")) {
                            String[] kv = pair.trim().split(":");
                            if (kv.length == 2) {
                                try {
                                    zoomRemap.put(Float.parseFloat(kv[0].trim()),
                                            Float.parseFloat(kv[1].trim()));
                                } catch (Exception ignored) {}
                            }
                        }
                        break;
                    case "zoom_drop":
                        for (String d : v.split(",")) {
                            try { zoomDrop.add(Float.parseFloat(d.trim())); }
                            catch (Exception ignored) {}
                        }
                        break;
                    case "enable_mode":
                        if (!v.isEmpty()) enableModes.add(v);
                        break;
                    case "disable_mode":
                        if (!v.isEmpty()) disableModes.add(v);
                        break;
                    case "fake.device":
                        fakeDevice = v;
                        break;
                    case "fake.model":
                        fakeModel = v;
                        break;
                    case "fake.product":
                        fakeProduct = v;
                        break;
                }
            }
        } catch (Throwable t) {
            loge("读取配置失败: " + t);
        }
        ensureLegendKeys(f);
        logi("配置: level=" + cfgLevel + " fake=" + cfgFake + " caps=" + cfgForceCaps
                + " aiwm=" + cfgAiWm + " cvnat=" + cfgCvNatural
                + " rawType=0x" + Integer.toHexString(cfgRawType) + " rawSize=" + cfgRawW + "x" + cfgRawH + " opMode=0x" + Integer.toHexString(cfgOpMode)
                + " device=" + fakeDevice + " model=" + fakeModel
                + " zoomRemap=" + zoomRemap.size()
                + " zoomDrop=" + zoomDrop.size()
                + " enableModes=" + enableModes.size()
                + " disableModes=" + disableModes.size());
    }

    /**
     * 补齐缺失的传奇色彩配置键（旧版本升级场景）。
     * 只在文件里完全没有该键时才追加，已有值一概不动。
     */
    private void ensureLegendKeys(java.io.File f) {
        if (f == null || !f.exists()) {
            return;
        }
        final String[] keys = {
                "legend.color", "legend.filter.m3", "legend.filter.m9",
                "legend.filter.m10r", "legend.degree", "ai.smartcomp",
                "ai.smartcomp.submit", "ai.smartcomp.dbgindex",
                "ai.smartcomp.cycle", "ai.smartcomp.dbgfrag", "cvtype.natural"};
        final String[] vals = {
                "1", "86", "84", "73", "100", "7", "1", "1", "0", "0", "0"};

        boolean[] present = new boolean[keys.length];
        try (BufferedReader br = new BufferedReader(new FileReader(f))) {
            String line;
            while ((line = br.readLine()) != null) {
                String t = line.trim();
                if (t.isEmpty() || t.startsWith("#")) continue;
                int eq = t.indexOf('=');
                if (eq < 0) continue;
                String k = t.substring(0, eq).trim();
                for (int i = 0; i < keys.length; i++) {
                    if (keys[i].equals(k)) present[i] = true;
                }
            }
        } catch (Throwable t) {
            loge("检查配置键失败: " + t);
            return;
        }

        StringBuilder add = new StringBuilder();
        for (int i = 0; i < keys.length; i++) {
            if (!present[i]) {
                add.append(keys[i]).append('=').append(vals[i]).append('\n');
            }
        }
        if (add.length() == 0) {
            return;
        }
        try (java.io.FileWriter fw = new java.io.FileWriter(f, true)) {
            fw.write("\n# ------------------------------------ 升级自动补齐 ---\n");
            fw.write(add.toString());
            logi("已补齐缺失配置键: " + add.toString().replace('\n', ' '));
        } catch (Throwable t) {
            loge("补写配置失败: " + t);
        }
    }

    private void countHook() { hookCount++; }

    private void logi(String s) {
        if (!cfgLog) return;
        if (!passFilter(s)) return;
        Log.i(TAG, s);
        XposedBridge.log(TAG + ": " + s);
    }

    /** 按 [tag] 前缀过滤日志；logFilter 为空则全部通过 */
    private boolean passFilter(String s) {
        if (logFilter.isEmpty()) return true;
        if (s == null) return false;
        int l = s.indexOf('[');
        if (l != 0) return false;
        int r = s.indexOf(']', l);
        if (r < 0) return false;
        return logFilter.contains(s.substring(l + 1, r));
    }

    /** 供 TiltSwitch 复用的过滤判断 */
    boolean logAllowed(String tag) {
        return logFilter.isEmpty() || logFilter.contains(tag);
    }

    /** 供扩展模块输出带标签的日志，走统一过滤 */
    void logiTag(String tag, String msg) {
        if (!cfgLog) return;
        if (!logAllowed(tag)) return;
        String line = "[" + tag + "] " + msg;
        Log.i(TAG, line);
        XposedBridge.log(TAG + ": " + line);
    }

    private void loge(String s) {
        Log.e(TAG, s);
        XposedBridge.log(TAG + " [E]: " + s);
    }
}
